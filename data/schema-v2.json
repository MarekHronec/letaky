{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marekhronec.github.io/letaky/data/schema-v2.json",
  "title": "Letákový prehľad – týždenné dáta v2",
  "type": "object",
  "required": [
    "schema_version",
    "tyzden",
    "obdobie",
    "generovane",
    "promo",
    "top_ids",
    "obchody",
    "otvaracie_hodiny",
    "zdroje_stav"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "tyzden": {
      "type": "string",
      "pattern": "^[0-9]{4}-W(?:0[1-9]|[1-4][0-9]|5[0-3])$",
      "maxLength": 8
    },
    "obdobie": { "$ref": "#/$defs/nullableShortText" },
    "generovane": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "maxLength": 35
    },
    "promo": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/promo" }
    },
    "top_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/slugId" },
      "uniqueItems": true,
      "minItems": 10,
      "maxItems": 10
    },
    "obchody": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/store" }
    },
    "otvaracie_hodiny": { "$ref": "#/$defs/openingHours" },
    "zdroje_stav": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/sourceStatus" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slugId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "description": "Publish-valid URL na presne povolenej first-party doméne. Plný business kontrakt vždy overuje aj scripts/routine/validate_daily.py.",
      "pattern": "^https://(?:predajne\\.kaufland\\.sk|www\\.lidl\\.sk|www\\.metro\\.sk|letaky\\.metro\\.sk|letak\\.billa\\.sk|www\\.billa\\.sk|www\\.coop\\.sk|www\\.tesco\\.sk|potravinydomov\\.itesco\\.sk|www\\.dm\\.sk|www\\.mojadm\\.sk|www\\.tetadrogerie\\.sk|www\\.vlada\\.gov\\.sk)(?::443)?(?:[/?#][^\\s]*)?$",
      "maxLength": 2048
    },
    "nullableHttpsUrl": {
      "anyOf": [
        { "$ref": "#/$defs/httpsUrl" },
        { "type": "null" }
      ]
    },
    "nullableShortText": {
      "anyOf": [
        { "type": "string", "maxLength": 120 },
        { "type": "null" }
      ]
    },
    "nullableMediumText": {
      "anyOf": [
        { "type": "string", "maxLength": 500 },
        { "type": "null" }
      ]
    },
    "money": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
    },
    "nullableMoney": {
      "anyOf": [
        { "$ref": "#/$defs/money" },
        { "type": "null" }
      ]
    },
    "promo": {
      "type": "object",
      "required": [
        "id",
        "obchod",
        "text",
        "plati_od",
        "plati_do",
        "podmienka",
        "priorita",
        "zdroj_url"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slugId" },
        "obchod": { "type": "string", "minLength": 1, "maxLength": 80 },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Stručná neutrálna parafráza faktov o ponuke; nie slogan, nákupná výzva ani skopírovaná marketingová veta."
        },
        "plati_od": { "type": "string", "format": "date", "maxLength": 10 },
        "plati_do": { "type": "string", "format": "date", "maxLength": 10 },
        "podmienka": { "$ref": "#/$defs/nullableMediumText" },
        "priorita": { "type": "integer", "enum": [1, 2, 3] },
        "zdroj_url": { "$ref": "#/$defs/httpsUrl" }
      },
      "additionalProperties": false
    },
    "offer": {
      "type": "object",
      "required": [
        "id",
        "product_id",
        "nazov",
        "mnozstvo",
        "kategoria",
        "cena",
        "cena_s_dph",
        "cena_povodna",
        "cena_povodna_s_dph",
        "jednotkova_cena",
        "jednotka",
        "zlava_letak_pct",
        "zlava_realna_pct",
        "bezna_cena_60d",
        "verdikt",
        "dovod_verdiktu",
        "podmienka",
        "poznamka",
        "zdroj_url",
        "historia_cien"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slugId" },
        "product_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^(?!(?:metro|kaufland|lidl|tesco|billa|coop|dm|teta)-)[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stabilné ID rovnakého produktu naprieč obchodmi a týždňami bez prefixu obchodu."
        },
        "nazov": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mnozstvo": { "$ref": "#/$defs/nullableShortText" },
        "kategoria": { "type": "string", "minLength": 1, "maxLength": 80 },
        "cena": { "$ref": "#/$defs/money" },
        "cena_s_dph": { "$ref": "#/$defs/nullableMoney" },
        "cena_povodna": { "$ref": "#/$defs/nullableMoney" },
        "cena_povodna_s_dph": { "$ref": "#/$defs/nullableMoney" },
        "jednotkova_cena": { "$ref": "#/$defs/nullableMoney" },
        "jednotka": {
          "anyOf": [
            { "type": "string", "maxLength": 32 },
            { "type": "null" }
          ]
        },
        "zlava_letak_pct": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 100 },
            { "type": "null" }
          ]
        },
        "zlava_realna_pct": {
          "anyOf": [
            { "type": "number", "minimum": -100, "maximum": 100 },
            { "type": "null" }
          ]
        },
        "bezna_cena_60d": { "$ref": "#/$defs/nullableMoney" },
        "verdikt": { "type": "string", "enum": ["realna", "umela", "neoverene"] },
        "dovod_verdiktu": { "$ref": "#/$defs/nullableMediumText" },
        "podmienka": { "$ref": "#/$defs/nullableMediumText" },
        "plati_od": { "type": ["string", "null"], "format": "date", "maxLength": 10 },
        "plati_do": { "type": ["string", "null"], "format": "date", "maxLength": 10 },
        "poznamka": {
          "anyOf": [
            { "type": "string", "maxLength": 1000 },
            { "type": "null" }
          ]
        },
        "zdroj_url": { "$ref": "#/$defs/nullableHttpsUrl" },
        "historia_cien": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/historyPoint" }
        }
      },
      "additionalProperties": false
    },
    "historyPoint": {
      "type": "object",
      "required": ["datum", "cena", "obchod", "zdroj_url"],
      "properties": {
        "datum": { "type": "string", "format": "date", "maxLength": 10 },
        "cena": { "$ref": "#/$defs/money" },
        "cena_s_dph": { "$ref": "#/$defs/nullableMoney" },
        "obchod": { "type": ["string", "null"], "maxLength": 80 },
        "zdroj_url": { "$ref": "#/$defs/nullableHttpsUrl" }
      },
      "additionalProperties": false
    },
    "store": {
      "type": "object",
      "required": ["id", "nazov", "plati_od", "plati_do", "letak_url", "polozky"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "nazov": { "type": "string", "minLength": 1, "maxLength": 80 },
        "plati_od": { "type": ["string", "null"], "format": "date", "maxLength": 10 },
        "plati_do": { "type": ["string", "null"], "format": "date", "maxLength": 10 },
        "letak_url": { "$ref": "#/$defs/nullableHttpsUrl" },
        "poznamka": {
          "anyOf": [
            { "type": "string", "maxLength": 1000 },
            { "type": "null" }
          ]
        },
        "polozky": {
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/offer" }
        }
      },
      "additionalProperties": false
    },
    "openingHours": {
      "type": "object",
      "required": [
        "obdobie",
        "checked_through",
        "lokalita",
        "poznamka_sviatky",
        "zdroj_sviatky_url",
        "predajne"
      ],
      "properties": {
        "obdobie": { "type": "string", "minLength": 1, "maxLength": 120 },
        "checked_through": { "type": "string", "format": "date", "maxLength": 10 },
        "lokalita": { "type": "string", "minLength": 1, "maxLength": 200 },
        "poznamka_sviatky": {
          "anyOf": [
            { "type": "string", "maxLength": 1000 },
            { "type": "null" }
          ]
        },
        "zdroj_sviatky_url": { "$ref": "#/$defs/nullableHttpsUrl" },
        "predajne": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/openingStore" }
        }
      },
      "additionalProperties": false
    },
    "openingStore": {
      "type": "object",
      "required": ["id", "nazov", "adresa", "hodiny", "vynimky", "zdroj_url", "overene"],
      "properties": {
        "id": { "type": "string", "enum": ["metro", "kaufland", "lidl"] },
        "nazov": { "type": "string", "minLength": 1, "maxLength": 80 },
        "adresa": { "$ref": "#/$defs/nullableShortText" },
        "hodiny": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "items": { "$ref": "#/$defs/openingHoursRow" }
        },
        "vynimky": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/openingException" }
        },
        "zdroj_url": { "$ref": "#/$defs/httpsUrl" },
        "overene": { "type": "string", "format": "date", "maxLength": 10 },
        "stav_overenia": {
          "type": "string",
          "enum": ["verified", "stale", "unavailable"]
        },
        "poznamka_overenia": {
          "anyOf": [
            { "type": "string", "maxLength": 300 },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "openingHoursRow": {
      "type": "object",
      "required": ["dni", "cas"],
      "properties": {
        "dni": { "type": "string", "minLength": 1, "maxLength": 80 },
        "cas": { "type": "string", "minLength": 1, "maxLength": 40 }
      },
      "additionalProperties": false
    },
    "openingException": {
      "type": "object",
      "required": ["datum", "nazov", "cas"],
      "properties": {
        "datum": { "type": "string", "format": "date", "maxLength": 10 },
        "nazov": { "type": "string", "minLength": 1, "maxLength": 120 },
        "cas": { "type": "string", "minLength": 1, "maxLength": 40 }
      },
      "additionalProperties": false
    },
    "sourceStatus": {
      "type": "object",
      "required": ["zdroj", "ok", "url", "poznamka"],
      "properties": {
        "zdroj": { "type": "string", "minLength": 1, "maxLength": 120 },
        "ok": { "type": "boolean" },
        "url": { "$ref": "#/$defs/nullableHttpsUrl" },
        "poznamka": {
          "anyOf": [
            { "type": "string", "maxLength": 2000 },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
